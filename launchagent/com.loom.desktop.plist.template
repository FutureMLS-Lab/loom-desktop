<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.loom.desktop</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Replace with the absolute path to your release build:
             <repo>/.build/release/LoomDesktop -->
        <string>__LOOM_DESKTOP_BINARY__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/loom-desktop.err.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/loom-desktop.out.log</string>
</dict>
</plist>
