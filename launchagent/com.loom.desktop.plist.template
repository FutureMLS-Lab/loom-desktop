<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.loom.desktop</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Replace with the absolute path to your release build:
             <repo>/.build/release/LoomDesktop -->
        <string>__LOOM_DESKTOP_BINARY__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Bring it back when it dies, but not when it meant to go: a plain
         <true/> here respawns after Quit, and loops forever if a second
         instance starts and exits on finding the first. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardErrorPath</key>
    <string>/tmp/loom-desktop.err.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/loom-desktop.out.log</string>
</dict>
</plist>
